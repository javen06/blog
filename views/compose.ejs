<%-include ("partials/header.ejs") %>

<div class="container">

    <h1 id="post-h1">compose:</h1>
    <form action="/compose" method="POST" class="posts-title">

        <div class="form-group">

            <label for="post-title">Title:</label>
            <input class="form-control" id="post-title" type="text" name="postTitle" required>

            <label for="post-body">Post:</label>
            <textarea class="form-control" name="postBody" id="post-body" cols="30" rows="5" required></textarea>

        
            <button class="link-btn" type="submit" name="button">Publish</button>

        </div>
    </form>
</div>



<%-include ("partials/footer.ejs") %>
