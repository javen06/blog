<!-- edit.ejs -->
<%- include("partials/header.ejs") %>



<div class="container">

    <h1 id="post-h1">Edit:</h1>
    <form action="/post/<%= post.id %>?_method=PUT" method="POST" class="posts-title">

        <div class="form-group">

            <label for="post-title">Title:</label>
            <input class="form-control" id="post-title" type="text" name="postTitle" value="<%= post.title %>" required>

            <label for="post-body">Post:</label>
            <textarea class="form-control" name="postBody" id="post-body" cols="30" rows="5" required><%= post.content %></textarea>

        
            <button type="submit">Save Changes</button>


        </div>
    </form>
</div>


<%- include("partials/footer.ejs") %>
