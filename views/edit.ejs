<!-- edit.ejs -->
<%- include("partials/header.ejs") %>



<div class="container">

    <h1 id="post-h1">Edit:</h1>
    <form action="/edit/<%= post.title %>" method="POST" class="posts-title">

        <div class="form-group">

            <label for="">Title:</label>
            <input class="form-control" type="text" name="postTitle" value="<%= post.title %>">

            <label for="">Post:</label>
            <textarea class="form-control" name="postBody" id="" cols="30" rows="5"><%= post.content %></textarea>
            
            <label for="">Upload Image:</label>
            <input class="img form-control" type="file" name="postImage" accept="image/*">

        
            <button type="submit">Save Changes</button>


        </div>
    </form>
</div>


<%- include("partials/footer.ejs") %>